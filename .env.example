# Supabase configuration (required for auth, realtime, edge functions, etc.)
# Get these from your Supabase project dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key-here

# Note: In some Supabase templates this key is called VITE_SUPABASE_ANON_KEY.
# The client accepts the anon key as the publishable key.
# If these are missing, the app will log a warning and fall back to static/mock data for features like ResonanceSpheresAtlas.